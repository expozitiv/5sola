# URL-ul aplicației (folosit pentru OpenGraph, sitemap etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Login „Sign In with GitHub” în /admin (GitHub → Settings → Developer settings → OAuth Apps).
# Authorization callback URL: https://www.5sola.ro/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Opțional: alte origini care pot folosi login-ul (ex. preview-uri Vercel), separate prin virgulă.
# CMS_ALLOWED_ORIGINS=https://5sola-*-ovidiuchis.vercel.app
